# ---- Backend ----
# Local Docker Compose Postgres 18 (see docker-compose.yml)
DATABASE_URL=postgresql+psycopg://kosh:kosh@localhost:5433/kosh
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Demo single-user app: every request is attributed to this user (see ASSUMPTIONS.md)
DEMO_USER_EMAIL=demo@kosh.app

# ---- Frontend ----
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:8000
